{
	"type": "object",
	"additionalProperties": false,
	"required": ["events"],
	"properties": {
		"events": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["key", "source", "pr", "prTitle", "url", "kind", "decision", "summary", "commit", "blocking", "nonBlocking", "feedback", "ask"],
				"properties": {
					"key": { "type": "string" },
					"source": { "const": "pr" },
					"pr": { "type": "integer" },
					"prTitle": { "type": "string" },
					"url": { "type": "string" },
					"kind": { "enum": ["review_finished", "review_failed", "approved", "teammate_review", "dequeued", "merged", "other"] },
					"decision": { "enum": ["not_important", "needs_attention", "needs_action"] },
					"summary": { "type": "string" },
					"commit": { "type": "string", "pattern": "^([0-9a-f]{40})?$" },
					"blocking": {
						"type": "array",
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["title", "anchor", "explanation", "ci"],
							"properties": { "title": { "type": "string" }, "anchor": { "type": "string" }, "explanation": { "type": "string" }, "ci": { "type": "boolean" } }
						}
					},
					"nonBlocking": {
						"type": "array",
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["title", "anchor", "explanation"],
							"properties": { "title": { "type": "string" }, "anchor": { "type": "string" }, "explanation": { "type": "string" } }
						}
					},
					"feedback": {
						"type": "array",
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["author", "anchor", "explanation"],
							"properties": { "author": { "type": "string" }, "anchor": { "type": "string" }, "explanation": { "type": "string" } }
						}
					},
					"ask": {
						"type": "object",
						"additionalProperties": false,
						"required": ["area", "line", "size"],
						"properties": { "area": { "type": "string" }, "line": { "type": "string" }, "size": { "type": "string" } }
					}
				}
			}
		}
	}
}
