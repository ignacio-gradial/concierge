#!/usr/bin/env bash
# `gx forge …` without the launcher, the same way src/forge.mjs runs it: concierge-forge status|events|prs …
# `./gx` runs scripts/gx/prepare.mjs first, which rebuilt the CLI for 1m45s on 2026-10-27 and outlasted a 90 s timeout.
set -euo pipefail
cd "$HOME/v2.main"
PATH="$HOME/.proto/bin:$PATH" exec "$HOME/.proto/bin/node" apps/cli/bin/run.js forge "$@"
